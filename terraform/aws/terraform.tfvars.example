region             = "ap-south-1"
availability_zone  = "ap-south-1a"
instance_type      = "t3.medium"
artifact_token     = "REDACTED"
artifact_endpoint  = "https://cspm.accuknox.com/api/v1/artifact/"
artifact_label     = "YOUR_LABEL"
artifact_tenant_id = 0 # your tenant id
omni_additional_flags = {
  "local-publisher"     = "false"
  "skip-malware-scan"   = "false"
  "log-level"           = "info"
  "log-format"          = "text"
  "trigger-immediately" = "true"
  "crontab"             = "@daily"
  # "vm-name-regex"       = "^windows-omni-target$"
  # "vm-label-regex"      = "foo=bar"
  # "vm-label-regex"      = "bar=bazz"
}
